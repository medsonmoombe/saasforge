{
 "compilerOptions": {
   "target": "ES2022",
   "module": "CommonJS",
   "moduleResolution": "Node10",
   "strict": true,
   "esModuleInterop": true,
   "skipLibCheck": true,
   "types": ["node"],
   "outDir": "./dist",
   "rootDir": "./src",
   "resolveJsonModule": true,
   "ignoreDeprecations": "6.0"
 },
 "include": ["src/**/*"],
 "exclude": ["node_modules", "dist"]
}